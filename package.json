{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:api": "tsx watch server/dev.ts",
    "build": "vite build && node server/notifications/buildWebWorker.mjs && node server/notifications/verifyBuild.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit && tsc --project api/tsconfig.json --noEmit",
    "test": "tsx --test src/test/*.test.ts",
    "test:api-runtime": "node scripts/Verify-AIRuntime.mjs"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/push-notifications": "8.1.3",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/noto-sans-bengali": "5.3.0",
    "@google/genai": "^2.4.0",
    "@noble/hashes": "2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/oidc": "4.0.4",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "12.12.1",
    "google-auth-library": "10.9.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@electric-sql/pglite": "0.5.13",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
