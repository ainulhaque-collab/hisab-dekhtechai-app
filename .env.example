# Server-only Gemini configuration. Never prefix the secret with VITE_ or send it to the client.
# Auto selects an available stable Gemini Flash model. This template does not activate the service.
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="auto"

# AI service is off until explicitly configured. Run npm run dev:api for local testing.
AI_ENABLED="false"
AI_LOCAL_DEVELOPMENT="false"
# Explicit Web + Android OAuth client IDs from the same project, comma separated.
GOOGLE_OAUTH_CLIENT_IDS=""
# Exact web/native origins. Android Capacitor uses https://localhost.
AI_ALLOWED_ORIGINS="http://localhost:3000,https://localhost"
AI_PER_MINUTE="3"
AI_PER_DAY="10"
AI_GLOBAL_PER_DAY="100"
# Required for production: a shared Redis REST store supporting atomic EVAL.
# No database is created by this template. Never use per-instance memory in production.
AI_REDIS_REST_URL=""
AI_REDIS_REST_TOKEN=""
# Vercel Marketplace pairs UPSTASH_REDIS_REST_URL/TOKEN or KV_REST_API_URL/TOKEN
# are also recognized automatically. Keep every Redis token server-only.
# Public HTTPS origin of the AI service for Android. Empty uses same-origin /api/ai.
# This is a public URL, never an API key; localhost cannot reach your PC from a phone.
VITE_AI_API_BASE_URL=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_CLIENT_ID: The public Google OAuth 2.0 Web Client ID
# Generated in Google Cloud Console under APIs & Services > Credentials
VITE_GOOGLE_CLIENT_ID=""

# Developer-only simulator. Leave false for real Google Drive, including localhost.
# Existing customer databases are never moved into this separate simulation store.
VITE_ENABLE_SYNC_SIMULATION="false"

# Google Cloud: register http://localhost:3000 as an authorized JavaScript origin.
# Android OAuth (debug/release) and this Web OAuth client must use the same Cloud project.
# Never put a client secret, access token or refresh token in VITE_* variables.
